# Database configuration (provided by certification_database container)
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=

# Storage for generated artifacts
CERT_STORAGE_DIR=data/storage

# Airflow real REST API integration
AIRFLOW_API_URL=https://airflow.example.com/api/v1
AIRFLOW_AUTH_SCHEME=basic  # basic | bearer | none
AIRFLOW_USERNAME=your-user
AIRFLOW_PASSWORD=your-password
# AIRFLOW_BEARER_TOKEN=your-token-when-using-bearer
AIRFLOW_VERIFY_SSL=true
AIRFLOW_TIMEOUT_SECONDS=15
AIRFLOW_POLL_INTERVAL_SECONDS=5
AIRFLOW_POLL_TIMEOUT_SECONDS=7200
