# S3/MinIO configuration for asset storage (REQUIRED to enable uploads)
STORAGE_S3_BUCKET=your-bucket-name
# Optional (for MinIO/self-hosted). For AWS S3 you can omit ENDPOINT and specify REGION.
STORAGE_S3_ENDPOINT=http://minio:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_USE_SSL=false
# Path style is typical for MinIO; set to false for AWS virtual-host style if needed.
STORAGE_S3_PATH_STYLE=true
# Expiry in seconds for presigned URLs
STORAGE_S3_URL_EXPIRY_SECONDS=3600
# If assets are served via public CDN/Ingress, set a base URL like https://cdn.example.com
STORAGE_S3_PUBLIC_BASE_URL=
