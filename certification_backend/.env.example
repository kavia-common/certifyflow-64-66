# Database (provided by certification_database container)
POSTGRES_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Storage (optional)
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_USE_SSL=true
STORAGE_S3_URL_EXPIRY_SECONDS=3600
STORAGE_S3_PUBLIC_BASE_URL=
STORAGE_S3_PATH_STYLE=true

# Airflow (optional)
AIRFLOW_API_URL=
AIRFLOW_AUTH_SCHEME=none
AIRFLOW_USERNAME=
AIRFLOW_PASSWORD=
AIRFLOW_BEARER_TOKEN=
AIRFLOW_VERIFY_SSL=true
AIRFLOW_TIMEOUT_SECONDS=15
AIRFLOW_POLL_INTERVAL_SECONDS=5
AIRFLOW_POLL_TIMEOUT_SECONDS=7200

# Email notifications
EMAIL_PROVIDER=smtp            # smtp | sendgrid | mailgun
EMAIL_FROM=cert-bot@example.com

# SMTP provider settings (when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false

# SendGrid settings (when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Mailgun settings (when EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=mg.example.com
MAILGUN_BASE_URL=https://api.mailgun.net
